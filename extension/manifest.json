{
  "manifest_version": 3,
  "name": "Semantic Search Filter",
  "version": "1.1.0",
  "description": "Семантическая фильтрация результатов поиска Google через локальный Python-сервер",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://google.com/*",
    "*://www.google.ru/*",
    "*://google.ru/*",
    "*://www.google.com.ua/*",
    "*://www.google.by/*",
    "*://www.google.kz/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/*",
        "*://google.com/*",
        "*://www.google.ru/*",
        "*://google.ru/*",
        "*://www.google.com.ua/*",
        "*://www.google.by/*",
        "*://www.google.kz/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
